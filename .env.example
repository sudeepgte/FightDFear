# ==============================================================================
# FightDFear — Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for production and replace all placeholders.
# Do not commit the real .env file.
# ==============================================================================

# --- Spring Active Profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Database Credentials (MySQL 8.0) ---
# Fresh empty database. Flyway creates the schema on first boot.
DB_URL=jdbc:mysql://db:3306/womenbesafety?createDatabaseIfNotExist=true&useSSL=true&requireSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=womenbesafety
DB_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_GEN_WITH_OPENSSL

# --- Application Public URL ---
APP_BASE_URL=https://YOUR_PRODUCTION_DOMAIN

# --- JWT Authentication (Must be >= 32 characters / 256-bit entropy) ---
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_CRYPTO_RANDOM_SECRET_FOR_JWT_SIGNING

# --- Session Cookie Security ---
SESSION_COOKIE_SECURE=true

# --- Payment Gateway (Razorpay Live Mode) ---
PAYMENT_MOCK=false
RAZORPAY_KEY_ID=rzp_live_PLACEHOLDER_KEY_ID
RAZORPAY_KEY_SECRET=PLACEHOLDER_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_UNIQUE_WEBHOOK_SECRET_32_CHARS

# --- Mail / SMTP Configuration ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@YOUR_PRODUCTION_DOMAIN
MAIL_PASSWORD=PLACEHOLDER_SMTP_APP_PASSWORD

# --- Google Maps API Key ---
GOOGLE_MAPS_API_KEY=PLACEHOLDER_RESTRICTED_GOOGLE_MAPS_API_KEY

# --- SMS Gateway (Optional / Fallback) ---
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=PLACEHOLDER_TWILIO_SID
TWILIO_AUTH_TOKEN=PLACEHOLDER_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=PLACEHOLDER_TWILIO_PHONE
MSG91_AUTH_KEY=PLACEHOLDER_MSG91_AUTH_KEY
MSG91_SENDER_ID=PLACEHOLDER_MSG91_SENDER_ID
