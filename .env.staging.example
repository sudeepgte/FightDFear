# Staging environment template — copy to .env on staging VPS.
# Uses Razorpay TEST keys and a separate MySQL database from production.

SPRING_PROFILES_ACTIVE=prod

# Staging database (separate from production!)
DB_URL=jdbc:mysql://db:3306/womenbesafe_staging?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=staging-changeme-use-strong-password

# Public staging URL (used in email/SMS deep links)
APP_BASE_URL=https://staging.fightdfire.example.com

# JWT — unique staging secret, min 32 chars
JWT_SECRET=STAGING_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN

# Mail — staging SMTP or mailhog
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=staging-mail@example.com
MAIL_PASSWORD=

# Razorpay SANDBOX / TEST mode keys (dashboard → Test Mode)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=staging-webhook-secret

# Never enable mock payments on shared staging
PAYMENT_MOCK=false

GOOGLE_MAPS_API_KEY=

SMS_ENABLED=false
SMS_PROVIDER=msg91
SMS_DEFAULT_COUNTRY_CODE=91

# Staging uploads — local disk is fine; use S3 for multi-instance staging
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Deploy script branch (do not use main for production-readiness work)
DEPLOY_BRANCH=cursor/production-readiness

# Flutter build (run locally against staging API)
# flutter run --dart-define=API_BASE_URL=https://staging.fightdfire.example.com
