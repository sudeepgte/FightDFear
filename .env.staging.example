# Staging environment template — copy to .env on the staging host.
# Uses Razorpay TEST keys and a separate MySQL database from production.
# Start from an empty database. Flyway creates the schema on first boot.

SPRING_PROFILES_ACTIVE=prod

# Staging database (separate from production)
DB_URL=jdbc:mysql://db:3306/womenbesafety_staging?createDatabaseIfNotExist=true&useSSL=true&requireSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=womenbesafety_staging
DB_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_STAGING_PASSWORD

# Public staging URL (used in email/SMS deep links)
APP_BASE_URL=https://YOUR_STAGING_DOMAIN

# JWT — unique staging secret, min 32 chars
JWT_SECRET=STAGING_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN

# Mail — staging SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=staging-mail@example.com
MAIL_PASSWORD=

# Razorpay SANDBOX / TEST mode keys (dashboard → Test Mode)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=staging-webhook-secret

PAYMENT_MOCK=false

GOOGLE_MAPS_API_KEY=

SMS_ENABLED=false
SMS_PROVIDER=msg91
SMS_DEFAULT_COUNTRY_CODE=91

STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Flutter against staging:
# flutter run --dart-define=API_BASE=https://YOUR_STAGING_DOMAIN
