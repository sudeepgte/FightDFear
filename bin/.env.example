# Copy to .env and fill in real values. Never commit .env.
# Production Docker uses SPRING_PROFILES_ACTIVE=prod (see docker-compose.yml).

# Spring profile (local dev: leave unset; Docker/production: prod)
# SPRING_PROFILES_ACTIVE=prod

# Database
DB_URL=jdbc:mysql://localhost:3306/womenbesafe?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme

# Public base URL (emails / SMS deep links)
APP_BASE_URL=http://localhost:8084

# JWT — required, min 32 chars (openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Mail (Gmail app password or SMTP credentials)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay (required in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payments — must be false in production
PAYMENT_MOCK=false

# Google Maps
GOOGLE_MAPS_API_KEY=

# SMS for SOS / panic (required for real text alerts)
# Set SMS_ENABLED=true and fill either Twilio OR Msg91
SMS_ENABLED=false
SMS_PROVIDER=msg91
SMS_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# File / media storage (Phase 4)
# local = disk under ./uploads (default); s3 = AWS S3 (requires S3_BUCKET)
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional CDN or bucket website URL (e.g. https://cdn.example.com/uploads)
S3_PUBLIC_BASE_URL=
